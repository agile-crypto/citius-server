#!/usr/bin/env bash
# .githooks/pre-push — runs the CI gate before every `git push`.
#
# Install once per clone:
#   make hooks
#
# To bypass in an emergency (use sparingly):
#   git push --no-verify

set -euo pipefail

echo "▶ pre-push: running CI gate (make ci) …"

if ! make ci; then
    echo ""
    echo "✗ pre-push: CI gate failed — push blocked."
    echo "  Fix the errors above, or use 'git push --no-verify' to bypass."
    exit 1
fi

echo "✓ pre-push: CI gate passed."
