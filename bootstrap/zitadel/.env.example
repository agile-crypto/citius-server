# bootstrap/zitadel/.env.example
#
# Copy to .env (gitignored) and fill in. Empty secrets are auto-generated by
# bootstrap.sh on first `up`. After init, do NOT change ZITADEL_MASTERKEY or
# the POSTGRES_* passwords — Zitadel encrypts data with the masterkey and
# Postgres data is encrypted at rest with the DB credentials. Losing or
# rotating these mid-flight is unrecoverable.

# --- Pinned image tags (bump deliberately, in a reviewable PR). ----------
# Never use `latest`. The bootstrap.sh preflight refuses to start otherwise.
ZITADEL_VERSION=v3.0.0
POSTGRES_VERSION=17-alpine
TRAEFIK_VERSION=v3.2

# --- Public endpoint -----------------------------------------------------
ZITADEL_DOMAIN=citius-auth.localhost
ZITADEL_EXTERNALPORT=443
ZITADEL_EXTERNALSECURE=true

# --- Secrets — generated on first `bootstrap.sh up` if blank -------------
ZITADEL_MASTERKEY=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_ZITADEL_PASSWORD=

# --- Bootstrap admin (machine user provisioned on first-instance setup) --
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_USERNAME=citius-bootstrap-sa
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_NAME=Citius Bootstrap Admin
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_PAT_SCOPES=openid
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_PAT_EXPIRATIONDATE=2099-01-01T00:00:00Z
ZITADEL_FIRSTINSTANCE_PATPATH=/pat/admin.pat

# --- TLS mode (chosen by overlay) ----------------------------------------
# local-tls  : mkcert-issued cert mounted into Traefik (dev)
# letsencrypt: ACME via Let's Encrypt (prod, requires public DNS + LETSENCRYPT_EMAIL)
TLS_MODE=local-tls
LETSENCRYPT_EMAIL=

# --- Citius client connection (emitted into citius-zitadel.env) ----------
# Where the integration test client should dial caas-server. Override if
# the server runs on a non-default host/port. Leave blank to default to
# 127.0.0.1:50051.
CITIUS_ADDR=
# Path to the PEM bundle the test client should trust. Leave blank to
# default to the mkcert root in local-tls mode.
CITIUS_TLS_CA=
# Optional SNI / certificate SAN expected by the test client. Leave blank
# to default to the host portion of CITIUS_ADDR.
CITIUS_TLS_SERVER_NAME=
